<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lifts LightOS's forced grayscale while the full-screen image viewer is
         open (see ColorMode). Signature-level, so it only works after a one-time
         adb grant; ungranted, the app just stays B&W. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- remoteMessaging (not dataSync): it's the semantically correct type and,
         crucially, it's one of the FGS types allowed to start from BOOT_COMPLETED
         on Android 14+ (dataSync is blocked at boot). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chat.SplashScreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holds the live Socket.IO connection so messages arrive (and notify)
             without Google Play push. remoteMessaging FGS so it can also start at
             boot. -->
        <service
            android:name=".socket.SocketService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- Reconnects the socket service after a reboot, no app launch needed. -->
        <receiver
            android:name=".socket.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Shares downloaded non-image attachments to external apps (ACTION_VIEW /
             share) via a content:// URI — no broad storage permission needed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver
            android:name=".LightSdkMarkerReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.thelightphone.sdk.ACTION_SDK_MARKER" />
            </intent-filter>
            <meta-data
                android:name="com.thelightphone.sdk.SDK_VERSION"
                android:value="0.1.0" />
        </receiver>
    </application>

</manifest>
